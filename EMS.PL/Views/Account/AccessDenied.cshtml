@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Access denied</title>
    <style>
        * { box-sizing: border-box; }
        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 24px;
            color: #1f2937;
            background: #f3f6fb;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        }
        main {
            width: min(100%, 520px);
            padding: 40px;
            text-align: center;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            box-shadow: 0 16px 45px rgba(15, 23, 42, .08);
        }
        .code { margin: 0; color: #64748b; font-size: 14px; font-weight: 700; letter-spacing: .12em; }
        h1 { margin: 12px 0; font-size: clamp(26px, 6vw, 34px); }
        p { margin: 0; color: #64748b; line-height: 1.7; }
        .actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
        a { padding: 11px 18px; border: 1px solid #d1d5db; border-radius: 8px; color: #1f2937; text-decoration: none; font-weight: 600; }
        a.primary { color: #fff; background: #2563eb; border-color: #2563eb; }
        a:hover { filter: brightness(.96); }
    </style>
</head>
<body>
    <main>
        <p class="code">403</p>
        <h1>Access denied</h1>
        <p>Your account does not have permission to view this page. If you think you should have access, contact HR or an administrator.</p>
        <div class="actions">
            <a href="javascript:history.back()">Go back</a>
            <a class="primary" href="/">Home</a>
        </div>
    </main>
</body>
</html>
